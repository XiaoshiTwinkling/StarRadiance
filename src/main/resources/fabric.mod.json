{
	"schemaVersion": 1,
	"id": "starradiance",
	"version": "${version}",
	"name": "StarRadiance",
	"description": "A real-astronomy night sky: the HYG star catalogue with precession and nutation, real solar and lunar ephemerides with eclipses, the eight planets plus the dwarf planets and Halley's comet, a draggable star chart and a star map with procedural globes.",
	"authors": [
		"XiaoshiTwinkling"
	],
	"contact": {
		"homepage": "https://github.com/XiaoshiTwinkling/StarRadiance",
		"sources": "https://github.com/XiaoshiTwinkling/StarRadiance"
	},
	"license": "CC0-1.0",
	"icon": "assets/starradiance/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.xiaoshi.StarRadiance"
		],
		"client": [
			"com.xiaoshi.StarRadianceClient"
		],
		"fabric-datagen": [
			"com.xiaoshi.StarRadianceDataGenerator"
		]
	},
	"mixins": [
		"starradiance.mixins.json",
		{
			"config": "starradiance.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"iris": "*"
	}
}
